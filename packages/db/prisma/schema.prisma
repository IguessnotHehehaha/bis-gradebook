// Electronic Gradebook with normalized assessments and student groups.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT @map("student")
  TEACHER @map("teacher")
  ADMIN   @map("admin")

  @@map("user_role")
}

enum Theme {
  LIGHT @map("light")
  DARK  @map("dark")

  @@map("theme")
}

enum Locale {
  EN @map("en")
  RU @map("ru")

  @@map("locale")
}

/// One row per person who can sign in. `id` is the Supabase Auth user id.
model AppUser {
  id        String   @id @db.Uuid
  email     String   @unique
  role      UserRole
  studentId Int?     @unique @map("student_id")
  teacherId Int?     @unique @map("teacher_id")
  /// Preferred interface settings, restored on every device after sign-in.
  theme     Theme    @default(LIGHT)
  locale    Locale   @default(EN)
  createdAt DateTime @default(now()) @map("created_at")

  student Student?    @relation(fields: [studentId], references: [studentId])
  teacher Teacher?    @relation(fields: [teacherId], references: [teacherId])`
  audits  AuditLog[]
  attestations AttestationResult[]

  @@map("app_users")
}

model Student {
  studentId Int    @id @default(autoincrement()) @map("student_id")
  fullName  String @map("full_name")
  email     String @unique
  groupId   Int    @map("group_id")
  group     StudentGroup @relation(fields: [groupId], references: [groupId])

  user        AppUser?
  enrollments Enrollment[]

  @@index([groupId])
  @@map("students")
}

model StudentGroup {
  groupId Int @id @default(autoincrement()) @map("group_id")
  groupName String @unique @map("group_name")
  students Student[]

  @@map("student_groups")
}

model Teacher {
  teacherId  Int    @id @default(autoincrement()) @map("teacher_id")
  fullName   String @map("full_name")
  email      String @unique
  department String

  user    AppUser?
  courses Course[]

  @@map("teachers")
}

model Course {
  courseId   Int    @id @default(autoincrement()) @map("course_id")
  courseName String @map("course_name")
  semester   String
  teacherId  Int    @map("teacher_id")

  assessments Assessment[]
  teacher     Teacher      @relation(fields: [teacherId], references: [teacherId])
  enrollments Enrollment[]

  @@map("courses")
}

/// Which student takes which course. A grade can only exist for an enrolled student.
model Enrollment {
  studentId  Int      @map("student_id")
  courseId   Int      @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")

  student Student @relation(fields: [studentId], references: [studentId])
  course  Course  @relation(fields: [courseId], references: [courseId])
  grades  Grade[]
  attestations AttestationResult[]

  @@id([studentId, courseId])
  @@map("enrollments")
}

model Assessment {
  assessmentId Int @id @default(autoincrement()) @map("assessment_id")
  courseId Int @map("course_id")
  assessmentName String @map("assessment_name")
  course Course @relation(fields: [courseId], references: [courseId])
  grades Grade[]

  @@unique([courseId, assessmentName])
  @@unique([assessmentId, courseId])
  @@map("assessments")
}

model Grade {
  gradeId        Int      @id @default(autoincrement()) @map("grade_id")
  studentId      Int      @map("student_id")
  courseId       Int      @map("course_id")
  assessmentId   Int      @map("assessment_id")
  assessment Assessment @relation(fields: [assessmentId, courseId], references: [assessmentId, courseId])
  score          Decimal  @db.Decimal(5, 2)
  gradeDate      DateTime @default(now()) @map("grade_date") @db.Date

  // Composite foreign key: (student, course) must exist in enrollments.
  enrollment Enrollment @relation(fields: [studentId, courseId], references: [studentId, courseId])

  @@unique([studentId, assessmentId])
  @@index([courseId])
  @@map("grades")
}

/// Append-only history of grade changes (who, what, when).
model AuditLog {
  auditId        Int      @id @default(autoincrement()) @map("audit_id")
  gradeId        Int?     @map("grade_id")
  courseId       Int      @map("course_id")
  studentId      Int      @map("student_id")
  action         String
  assessmentName String   @map("assessment_name")
  oldScore       Decimal? @map("old_score") @db.Decimal(5, 2)
  newScore       Decimal? @map("new_score") @db.Decimal(5, 2)
  changedBy      String   @map("changed_by") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at")

  user AppUser @relation(fields: [changedBy], references: [id])

  @@index([courseId])
  @@map("audit_log")
}

/// Two independently entered course attestation scores; the average is derived.
model AttestationResult {
  studentId Int @map("student_id")
  courseId Int @map("course_id")
  attestationNumber Int @map("attestation_number")
  score Decimal @db.Decimal(5, 2)
  changedBy String @map("changed_by") @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  enrollment Enrollment @relation(fields: [studentId, courseId], references: [studentId, courseId])
  user AppUser @relation(fields: [changedBy], references: [id])

  @@id([studentId, courseId, attestationNumber])
  @@index([courseId])
  @@map("attestation_results")
}
