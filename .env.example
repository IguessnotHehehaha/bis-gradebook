# Copy this file to `.env` in the project root:   cp .env.example .env
# Never commit .env (it is in .gitignore).

# ---------------------------------------------------------------------------
# Database (Supabase: Project -> Connect). Use the project's Postgres URLs.
# ---------------------------------------------------------------------------
# Used by the running app. Supabase "Transaction pooler" (port 6543) works.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Used for migrations, seeding and backups. "Session pooler" (port 5432) or direct connection.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Supabase Auth (Project Settings -> API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY
# SECRET. Server only. Used by `npm run db:seed` to create demo logins. Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Password given to every demo account created by the seed.
SEED_PASSWORD=Gradebook123!

# ---------------------------------------------------------------------------
# Backup (the second database; `docker compose up -d backup_db` starts this one)
# ---------------------------------------------------------------------------
BACKUP_DATABASE_URL=postgresql://backup:backup_pass@localhost:5433/gradebook_backup
BACKUP_INTERVAL_MINUTES=60
BACKUP_KEEP=10

# ---------------------------------------------------------------------------
# Development only. Lets you "sign in as" any seeded person without Supabase Auth.
# Ignored in production builds. Leave false when using Supabase.
# ---------------------------------------------------------------------------
DEV_FAKE_AUTH=false
